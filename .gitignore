# Database (live DB plus the sync-chain replicas: .snapshot / .shipping and
# their -shm/-wal sidecars are multi-GB production copies that `data/*.db`
# does not match)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.bak*
data/*.db.snapshot
data/*.db.snapshot-shm
data/*.db.snapshot-wal
data/*.db.shipping
data/*.db.shipping.*
data/*.db.incoming
# Runtime state written by the collector / pipeline / alerting
data/raw-capture/
data/recovery/
data/collection-state/
data/ark-breaker.json
data/pricing-notification-state.json
data/*.lock
data/.sync.lock/
data/alert-events.jsonl
data/alert-events.lock
data/alert-state.json
data/pricing_cache.json
data/wechat-discovery.db
data/wechat-discovery.db-shm
data/wechat-discovery.db-wal
data/wechat-discovery-session.json
data/.wechat-discovery-session.*
data/wechat-discovery-browser/
data/recovery/wechat-discovery/
# aihot-fit evalset staging + run artifacts (evalset is promoted to the data repo by hand)
# Keep this exclusion whole: the production deploy REFUSES any commit that tracks a path
# under data/ (it is runtime-owned; `checkout-index -f` would clobber live state git
# cannot restore -- see deploy/sync/deploy_code.py `_is_runtime_owned`, allowlist is three
# config files). A `!data/...` exception here therefore does not just add a file, it
# breaks deploys. Measured: it did, on 09dea35. Durable measurement inputs live next to
# their consumer instead -- scripts/eval/labels/.
data/eval-fit/

# Python
__pycache__/
*.pyc
.mypy_cache/
.venv/
.pytest_cache/

# The lockfile is committed for reproducible deploys (uv sync --locked on the
# server). A global gitignore excludes uv.lock by default; override it here.
!uv.lock

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Env
.env

# Deploy (actual configs contain secrets / local paths)
deploy/cloudflared/config.yml
deploy/launchd/*.plist
deploy/wewe-rss/

# Runtime logs
logs/

# Pipeline runtime state (kernel flock anchor + activity generation)
.pipeline.flock
.pipeline.activity

# Wechat2RSS container runtime state (subscriptions DB, recreated by the service).
deploy/wechat2rss/data/

# Human-eval / labeling tooling and served bundles (never committed).
/.label-serve/

# Local scratch: session handoffs, ad-hoc notes, review output. None of it is
# product material and some of it quotes private conversations.
/handoffs/
/tmp/
/.local/
/1.txt
/screenshot-*.png

# Collector runtime state (kernel flock anchor + activity generation)
.collector.flock
.collector.activity

# Immutable offline evaluation assets; definitions and result interpretation are tracked.
/runs/
/experiments/
/data/evaluation-archive/
/human-evals/

# Execution-plan workspace (audit trail is promoted to docs/plans/ after completion).
# tests/test_repository_hygiene.py requires this to be the last rule in the file.
/plans/
