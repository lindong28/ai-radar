      "source": "evals/_shared/metrics.py"
    },
    {
      "task": "*",
      "metric_name": "recall",
      "unit": "fraction",
      "direction": "higher",
      "definition": "给定逐条题集内 reference.featured=true 的题被阈值规则预测精选覆盖的比例；不代表全窗召回",
      "source": "evals/_shared/metrics.py"
    }
  ]
}
