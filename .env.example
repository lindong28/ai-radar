# ── LLM Provider Keys (at least one is required) ──────────────

# DeepSeek (used for prefilter / scoring / enrichment)
DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Volcengine ARK platform — tried FIRST when ARK_API_KEY is set (consumes the
# prepaid agent-plan allowance), with DeepSeek as automatic fallback.
# ARK_API_KEY=xxx
# Agent-plan endpoint (…/api/plan/v3) rejects response_format=json_object and
# defaults thinking ON, so the ARK request path drops the former and forces the
# latter off automatically — no extra config needed.
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI (used by codex_gpt_mini scorer)
# OPENAI_API_KEY=sk-xxx

# GLM (used by glm prefilter provider)
# GLM_API_KEY=xxx

# ── Provider Selection ────────────────────────────────────────

# AI_RADAR_PREFILTER=deepseek_v32
# AI_RADAR_SCORER=deepseek_v4_flash   # flash (cheaper) is the default; deepseek_v4_pro / codex_gpt_mini also available
# AI_RADAR_ENRICHER=deepseek_v4_pro

# ── Tuning ────────────────────────────────────────────────────

# AI_RADAR_DB=data/radar.db
# AI_RADAR_LLM_USAGE_DB=data/llm_usage.db
# AI_RADAR_ENRICH_WORKERS=1
# AI_RADAR_DEEPSEEK_TIMEOUT=90
# ARK request thinking mode (default disabled to avoid reasoning-token cost on the agent plan)
# AI_RADAR_ARK_THINKING=disabled
# ARK quota breaker: after a quota/rate-limit error, skip ARK for this many seconds (default 7200 = 2h)
# AI_RADAR_ARK_BREAKER_COOLDOWN_SECONDS=7200
# AI_RADAR_ARK_BREAKER_STATE=data/ark-breaker.json
# AI_RADAR_OPENAI_TIMEOUT=60
# AI_RADAR_OPENAI_SCORER_MODEL=o4-mini
# AI_RADAR_FORCE_HEURISTIC=false
# AI_RADAR_ALLOW_LLM_FALLBACK=true
# USD-to-CNY display and ARK nominal-tariff conversion rate (default 7.2).
# AI_RADAR_USD_CNY=7.2

# ── Site Identity / Public Domain ─────────────────────────────

# Leave AI_RADAR_SITE_DOMAIN empty for localhost-only CORS and a neutral
# fetch User-Agent. Set it to your public domain when deployed. Set the
# remaining values to your own repository and maintainer links for /about.
# AI_RADAR_SITE_DOMAIN=
# AI_RADAR_SITE_REPO_URL=https://github.com/your-org/ai-radar
# AI_RADAR_SITE_MAINTAINER=your-name
# AI_RADAR_SITE_MAINTAINER_URL=
# AI_RADAR_SITE_X_URL=

# ── Optional WeChat Interpretation Integration ────────────────

# Disabled by default. Enable only when you provide an ai-assistant-compatible
# summary-agent implementation at AI_ASSISTANT_ROOT.
# AI_RADAR_ENABLE_INTERPRET=false
# AI_ASSISTANT_ROOT=
# AI_RADAR_INTERPRET_USER=default

# ── Content Sources ───────────────────────────────────────────

# App-only Bearer Token for the official X API. AI Radar uses it only for
# public, read-only account timelines. Each configured account is limited to
# one request and at most 5 non-reply, non-retweet Posts per fetch round. A
# saved cursor drains a busy account across later rounds without raising that
# cap; the first request is limited to 20 minutes and never backfills history.
# X_BEARER_TOKEN=xxx

# Egress proxy used only for fetching X tweet media (pbs.twimg.com) through the
# same-origin /img endpoint. Required on hosts with no route to twimg — without
# it those images 404 immediately rather than hanging for the full timeout, so
# the site degrades to "X cards have no images" instead of getting slow.
# Format: http://<user>:<password>@<host>:<port>  (see docs/adr/057-*.md)
#
# From behind the GFW, point this at a LOCAL SSH-tunnel endpoint, not the remote
# proxy IP directly: a plaintext forward proxy leaks `CONNECT pbs.twimg.com` on
# the wire and the GFW resets it. See ADR-057; the production host runs an
# `ai-radar-img-tunnel` systemd service (ssh -L 39148:127.0.0.1:39147 …) and
# sets this to the tunnel's local port.
# AI_RADAR_IMG_PROXY_URL=http://user:password@127.0.0.1:39148

# Mp2RSS feed for WeChat Official Account ingestion. The URL embeds a private
# key, so keep it out of git: put the real value in `.env`, `~/.claude/.env`,
# or the environment used to run the pipeline. If unset or empty, the loader
# skips the wx_mp2rss source and continues with the remaining sources.
# MP2RSS_FEED_URL=https://www.mp2rss.com/feed/xxx

# Self-hosted Wechat2RSS combined feed, run alongside Mp2RSS so the two can be
# compared on live production coverage before either is switched off. Articles
# both feeds carry are stored once (account + title within a five-minute
# publish window), so enabling this adds only what Mp2RSS missed. The URL is
# loopback plus a per-deployment token, which makes it machine-local: put it in
# this project's `.env`, not the shared `~/.claude/.env`. If unset or empty,
# the loader skips wx_wechat2rss and the remaining sources still run.
# WECHAT2RSS_FEED_URL=http://127.0.0.1:8080/feed/all.xml?k=xxx

# ── Monitoring / Alerting (optional) ──────────────────────────

# Feishu custom-bot webhooks used by `./run.sh admin alert-check` and the
# `alert` launchd service. Both are required: page alerts use ALERT, while
# lower-urgency notices use NOTIFICATION. Keep these secrets out of git; put
# the real values in `.env`, `~/.claude/.env`, or the environment used to run
# `./install.sh alert`.
# FEISHU_GENERAL_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_GENERAL_NOTIFICATION_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ── EdgeOne CDN (optional) ───────────────────────────────────

# Least-privilege Tencent Cloud key used by `./run.sh admin edgeone check`
# (reconcile the console's node-cache rules against web/edgeone-cache-rules.json)
# and `admin edgeone purge --url` (clear a stale edge copy). Needs only
# teo:DescribeL7AccRules and teo:CreatePurgeTask. When unset, `check` exits 2
# (NOT VERIFIED) rather than pretending the rules were checked.
# EDGEONE_SECRET_ID=
# EDGEONE_SECRET_KEY=
# EDGEONE_ZONE_ID=zone-xxxx

# ── Eval (optional) ──────────────────────────────────────────

# AI_RADAR_EVAL_REPEAT_BORDERLINE=false
# AI_RADAR_DEEPSEEK_JUDGE_MODEL=deepseek-chat
# AI_RADAR_EVAL_MAX_TOKENS=2048
