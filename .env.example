# AI Radar — Environment Variables

# LLM Provider API Keys (set the ones you use)
# GLM_API_KEY=your-glm-api-key
# OPENAI_API_KEY=sk-your-openai-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Provider selection
# AI_RADAR_PREFILTER=glm
# AI_RADAR_SCORER=codex_gpt_mini

# Database path override (default: ./data/radar.db)
# AI_RADAR_DB=./data/radar.db

# Enrich concurrency
# AI_RADAR_ENRICH_WORKERS=1
