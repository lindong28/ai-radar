# Copy to .env and fill in. .env is gitignored — never commit the real values.

# --- Required on first boot ---------------------------------------------
# The email you put in the Alipay transfer memo, all lowercase.
LIC_EMAIL=you@example.com
# Activation code, emailed within 24h of payment.
LIC_CODE=

# Address embedded in generated RSS links (must include the port). This only
# rewrites links inside the feed; it does not change what the service listens
# on. ai-radar reads the feeds over localhost, so localhost is correct here.
RSS_HOST=127.0.0.1:8080

# --- Recommended to set before the first boot ----------------------------
# Admin password. Without it, anyone who can reach the port can add or delete
# subscriptions. The service also prints a generated token to its log on first
# start; setting it here means we never depend on reading that log.
RSS_TOKEN=

# Encrypt feed IDs so a feed URL does not expose the account's numeric biz.
# The docs recommend deciding this at first deploy: flipping it later only
# re-issues a feed's URL when that feed next updates, so the two states coexist
# for a while and every consumer has to be re-pointed piecemeal.
RSS_ENC_FEED_ID=1

# --- Alerting -------------------------------------------------------------
# Fires on WeChat risk-control, account login failure, and service errors.
# NOTE: the payload is {"msgtype":"text","text":{"content":"..."}} — that is
# the 企业微信 bot schema, NOT Feishu's ({"msg_type":"text","content":{"text":...}}).
# Pointing this straight at FEISHU_GENERAL_NOTIFICATION_WEBHOOK will be
# rejected by Feishu; it needs a small translating endpoint in between.
BOT_WEBHOOK_URL=
