<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ai-radar:managed-launch-agent:v1 -->
  <!-- Start at login and retry every 20 minutes after a runtime stop.
       A failed start can be retried after disk space becomes available.
       Before intentionally stopping OrbStack, run ./uninstall.sh orbstack.
       See docs/operations/wechat-ingestion.md for maintenance and limits. -->
  <key>Label</key><string>live.aiplanet.ai-radar.orbstack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/orbctl</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>1200</integer>
  <key>StandardOutPath</key><string>/tmp/ai-radar-orbstack.log</string>
  <key>StandardErrorPath</key><string>/tmp/ai-radar-orbstack.err</string>
</dict>
</plist>
