<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ai-radar:managed-launch-agent:v1 -->
  <key>Label</key><string>live.aiplanet.ai-radar.alert</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /path/to/ai-radar &amp;&amp; PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" ./run.sh admin alert-check</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/ai-radar</string>
  <!-- __AI_RADAR_ALERT_ENVIRONMENT__ -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/path/to/ai-radar/logs/alert-check.log</string>
  <key>StandardErrorPath</key><string>/path/to/ai-radar/logs/alert-check.err.log</string>
</dict>
</plist>
