<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>live.aiplanet.ai-radar.wewe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /path/to/ai-radar/deploy/wewe-rss &amp;&amp; /usr/local/bin/docker compose -f docker-compose.sqlite.yml up</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/ai-radar/deploy/wewe-rss</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/tmp/ai-radar-wewe.log</string>
  <key>StandardErrorPath</key><string>/tmp/ai-radar-wewe.err</string>
</dict>
</plist>
